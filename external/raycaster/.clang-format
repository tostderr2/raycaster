# BasedOnStyle: LLVM
# Language: Cpp
#
# # Indentation & Tabs
# UseTab: Never
# IndentWidth: 4
# TabWidth: 4
# ColumnLimit: 100
#
# # Bracing & Short Line Settings
# BreakBeforeBraces: Attach
# AllowShortFunctionsOnASingleLine: Inline # Inline allows member functions inside class/struct bodies to stay single-line
# AllowShortBlocksOnASingleLine: true
# AllowShortIfStatementsOnASingleLine: Always
# AllowShortLoopsOnASingleLine: true
#
# # Attribute Formatting (LLVM / Clang 16+)
# BreakAttributes: Always



BasedOnStyle: LLVM
Language: Cpp

# Indentation & Tabs
UseTab: Never
IndentWidth: 4
TabWidth: 4
ColumnLimit: 100

# Bracing Style
# BreakBeforeBraces: Allman
BreakBeforeBraces: Attach

# Short Statement Rules
AllowShortFunctionsOnASingleLine: None
AllowShortBlocksOnASingleLine: false
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false

# Include Management
SortIncludes: CaseSensitive
IncludeBlocks: Regroup
IncludeCategories:
  # Force GLAD to stay at the very top (OpenGL header order requirement)
  - Regex: '<glad/glad\.h>|"glad/glad\.h"'
    Priority: 1
    SortPriority: 1
  # C Standard Library
  - Regex: '<[a-z_0-9]+(\.h)?>'
    Priority: 2
    SortPriority: 2
  # C++ Standard Library
  - Regex: '<[a-zA-Z0-9_]+>'
    Priority: 3
    SortPriority: 3
  # Third-party / Vendor libraries (SDL3, GLFW, GLM, etc.)
  - Regex: '<.*>'
    Priority: 4
    SortPriority: 4
  # Project-local headers
  - Regex: '.*'
    Priority: 5
    SortPriority: 5

# Formatting
AlignAfterOpenBracket: Align
AlignConsecutiveAssignments: None
AlignConsecutiveDeclarations: None
SpaceAfterCStyleCast: false
SpacesInParentheses: false

